      "id": "e0fbdb76-2221-40b9-94d7-db713d680410",
      "name": "Render Links",
      "description": {
        "content": "Stateless, cacheable HMAC-signed GET render URLs.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6c3db045-db7b-42c7-bf9c-41bd87852e55",
          "name": "Render via a signed render link",
          "request": {
            "name": "Render via a signed render link",
            "description": {
              "content": "Returns a render directly from a stateless, cacheable URL. The token is an HMAC-SHA256 signature of the URL-encoded options query string, generated server-side with the project secret. Render options are passed as query-string parameters (url or html is required).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":apiKey",
                ":token",
                ":format"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "The website URL to render (required unless html is supplied)."
                },
                {
                  "disabled": false,
                  "key": "html",
                  "value": "<string>",
                  "description": "Raw HTML to render (required unless url is supplied)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "apiKey",
                  "description": "(Required) The project publishable API key."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) HMAC-SHA256 hex signature of the URL-encoded options query string, signed with the project secret. Use 'true' for unsigned links if the project allows them."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "format",
                  "description": "(Required) Output format for the render."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
